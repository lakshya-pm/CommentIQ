YOUTUBE_API_KEY=your_youtube_data_api_v3_key_here

# Reddit API credentials — from https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=CommentIQ/1.0 by your_reddit_username

# Optional: use LoRA fine-tuned RoBERTa adapter (run scripts/finetune_lora.py first)
USE_LORA_ADAPTER=false

# Optional: demo mode — loads bundled sample result without API keys
DEMO_MODE=false
