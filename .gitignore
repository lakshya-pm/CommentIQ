# Virtual Environment
venv/
env/

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# Environment variables (NEVER commit this)
.env

# VS Code settings
.vscode/

# Generated output (regenerated at runtime)
downloads/
static/generated/*.png
static/generated/*.jpg

# OS files
Thumbs.db
.DS_Store
*.swp
*.swo

# NLTK data (downloaded at runtime)
nltk_data/

# Pytest / coverage
.pytest_cache/
.coverage
htmlcov/

# Raw Kaggle dataset (large ~200MB — download separately)
youtube_comments_cleaned.csv

# In-domain labelled data (may contain personal comment text)
data/raw_dataset.csv

# Report PNGs are regenerated by scripts/evaluate.py
reports/*.png

# Scratch / one-off scripts
scratch_*.py